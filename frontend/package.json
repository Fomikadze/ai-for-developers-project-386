    "lint": "eslint . && stylelint --allow-empty-input \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "generate": "[ -f ../typespec/openapi.yaml ] && openapi-ts || echo 'пропущено: нет typespec/openapi.yaml'",
